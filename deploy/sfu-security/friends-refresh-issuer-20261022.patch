+)
+
+type relayRefreshBoundParticipant struct {
+	*typesfakes.FakeLocalParticipant
+	verifiedKey string
+}
+
+func (p *relayRefreshBoundParticipant) TokenAPIKey() string { return p.verifiedKey }
+
+func relayRefreshFake(grants *auth.ClaimGrants) *typesfakes.FakeLocalParticipant {
+	p := &typesfakes.FakeLocalParticipant{}
+	p.ClaimGrantsReturns(grants)
+	p.IdentityReturns(livekit.ParticipantIdentity(grants.Identity))
+	return p
+}
+
+func TestRelayRefreshIssuerAuthenticatedRoundTripAndSignature(t *testing.T) {
+	keys := map[string]string{
+		"owned-community-key": "owned-community-secret-longer-than-thirty-two-bytes",
+		"owned-friends-key":   "owned-friends-secret-longer-than-thirty-two-bytes",
+	}
+	for _, key := range []string{"owned-community-key", "owned-friends-key"} {
+		t.Run(key, func(t *testing.T) {
+			other := "owned-community-key"
+			if key == other {
+				other = "owned-friends-key"
+			}
+			attributes := map[string]string{"relay_session": "owned-session", "relay_channel": "owned-channel",
+				"relay_server": "owned-server", "_relay_verified_api_key": other}
+			original, err := auth.NewAccessToken(key, keys[key]).SetIdentity("owned-user").
+				SetName("Owned QA").SetMetadata("owned-metadata").SetAttributes(attributes).
+				SetVideoGrant(&auth.VideoGrant{Room: "owned-private-room", RoomJoin: true}).
+				SetValidFor(2 * time.Hour).ToJWT()
+			require.NoError(t, err)
+			// A signed but client-controlled extra claim must not become the trusted
+			// binding. Both actual entrypoints use the helper exercised below.
+			original = relayRefreshSpoofClaim(t, original, other, keys[key])
+			request := httptest.NewRequest(http.MethodGet, "http://owned.invalid/rtc", nil)
+			SetAuthorizationToken(request, original)
+			recorder := httptest.NewRecorder()
+			var init routing.ParticipantInit
+			called := false
+			NewAPIKeyAuthMiddleware(auth.NewFileBasedKeyProviderFromMap(keys)).ServeHTTP(recorder, request,
+				func(w http.ResponseWriter, r *http.Request) {
+					called = true
+					grants := GetGrants(r.Context())
+					init = routing.ParticipantInit{Identity: livekit.ParticipantIdentity(grants.Identity),
+						Grants: grants, TokenExpiresAt: GetTokenExpiresAt(r.Context()), VerifiedAPIKey: other}
+					bindVerifiedParticipantTokenKey(r.Context(), &init)
+					w.WriteHeader(http.StatusOK)
+				})
+			require.True(t, called)
+			require.Equal(t, http.StatusOK, recorder.Code)
+			require.Equal(t, key, init.VerifiedAPIKey)
+			// Exercise the existing inter-node transport twice, including resume.
+			for range 2 {
+				wire, err := init.ToStartSession("owned-private-room", "owned-connection")
+				require.NoError(t, err)
+				restored, err := routing.ParticipantInitFromStartSession(wire, "owned-region")
+				require.NoError(t, err)
+				init = *restored
+				init.Reconnect = true
+				require.Equal(t, key, init.VerifiedAPIKey)
+			}
+			base := relayRefreshFake(init.Grants)
+			base.TokenExpiresAtReturns(init.TokenExpiresAt)
+			participant := &relayRefreshBoundParticipant{FakeLocalParticipant: base, verifiedKey: init.VerifiedAPIKey}
+			manager := &RoomManager{config: &config.Config{Keys: keys}}
+			require.NoError(t, manager.refreshToken(participant))
+			require.Equal(t, 1, base.SendRefreshTokenCallCount())
+			refreshed := base.SendRefreshTokenArgsForCall(0)
+			verifier, err := auth.ParseAPIToken(refreshed)
+			require.NoError(t, err)
+			require.Equal(t, key, verifier.APIKey())
+			claims, grants, err := verifier.Verify(keys[key])
+			require.NoError(t, err)
+			require.Equal(t, key, claims.Issuer)
+			require.Equal(t, "owned-user", claims.Subject)
+			require.Equal(t, init.Grants.Identity, grants.Identity)
+			require.Equal(t, init.Grants.Name, grants.Name)
+			require.Equal(t, init.Grants.Metadata, grants.Metadata)
+			require.Equal(t, init.Grants.Video, grants.Video)
+			require.Equal(t, attributes, grants.Attributes)
+			require.NotNil(t, claims.ExpiresAt)
+			require.WithinDuration(t, init.TokenExpiresAt, claims.ExpiresAt.Time, time.Second)
+			_, _, err = verifier.Verify(keys[other])
+			require.Error(t, err, "another configured service key must not verify this refreshed token")
+		})
+	}
+}
+
+func relayRefreshSpoofClaim(t *testing.T, token, spoofedKey, secret string) string {
+	t.Helper()
+	parts := strings.Split(token, ".")
+	require.Len(t, parts, 3)
+	raw, err := base64.RawURLEncoding.DecodeString(parts[1])
+	require.NoError(t, err)
+	var claims map[string]any
+	require.NoError(t, json.Unmarshal(raw, &claims))
+	claims["_relay_verified_api_key"] = spoofedKey
+	raw, err = json.Marshal(claims)
+	require.NoError(t, err)
+	signed := parts[0] + "." + base64.RawURLEncoding.EncodeToString(raw)
+	mac := hmac.New(sha256.New, []byte(secret))
+	_, err = mac.Write([]byte(signed))
+	require.NoError(t, err)
+	return signed + "." + base64.RawURLEncoding.EncodeToString(mac.Sum(nil))
+}
+
+func TestRelayRefreshIssuerFailsClosedWithoutEmittingToken(t *testing.T) {
+	const secret = "owned-test-secret-longer-than-thirty-two-bytes"
+	for _, test := range []struct {
+		name    string
+		keys    map[string]string
+		binding string
+		legacy  bool
+	}{
+		{"unknown-bound-key", map[string]string{"owned-a": secret, "owned-b": secret}, "owned-unknown", false},
+		{"revoked-bound-key-never-falls-back", map[string]string{"owned-a": secret}, "owned-removed", false},
+		{"bound-key-with-empty-secret", map[string]string{"owned-a": secret, "owned-b": ""}, "owned-b", false},
+		{"empty-binding-multiple-keys", map[string]string{"owned-a": secret, "owned-b": secret}, "", false},
+		{"legacy-interface-multiple-keys", map[string]string{"owned-a": secret, "owned-b": secret}, "", true},
+		{"no-keys", map[string]string{}, "", false},
+		{"single-empty-key-id", map[string]string{"": secret}, "", true},
+		{"single-empty-secret", map[string]string{"owned-a": ""}, "", true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			base := relayRefreshFake(&auth.ClaimGrants{Identity: "owned-user", Video: &auth.VideoGrant{RoomJoin: true}})
+			var participant types.LocalParticipant = base
+			if !test.legacy {
+				participant = &relayRefreshBoundParticipant{FakeLocalParticipant: base, verifiedKey: test.binding}
+			}
+			manager := &RoomManager{config: &config.Config{Keys: test.keys}}
+			err := manager.refreshToken(participant)
+			require.Error(t, err)
+			require.Zero(t, base.SendRefreshTokenCallCount())
+			require.NotContains(t, err.Error(), secret)
+			if test.binding != "" {
+				require.NotContains(t, err.Error(), test.binding)
+			}
+		})
+	}
+}
+
+func TestRelayRefreshIssuerSingleKeyLegacyCompatibility(t *testing.T) {
+	const key = "owned-only-key"
+	const secret = "owned-only-secret-longer-than-thirty-two-bytes"
+	for _, legacy := range []bool{false, true} {
+		base := relayRefreshFake(&auth.ClaimGrants{Identity: "owned-user", Video: &auth.VideoGrant{Room: "owned-room", RoomJoin: true}})
+		var participant types.LocalParticipant = base
+		if !legacy {
+			participant = &relayRefreshBoundParticipant{FakeLocalParticipant: base}
+		}
+		manager := &RoomManager{config: &config.Config{Keys: map[string]string{key: secret}}}
+		require.NoError(t, manager.refreshToken(participant))
+		require.Equal(t, 1, base.SendRefreshTokenCallCount())
+		verifier, err := auth.ParseAPIToken(base.SendRefreshTokenArgsForCall(0))
+		require.NoError(t, err)
+		require.Equal(t, key, verifier.APIKey())
+		_, _, err = verifier.Verify(secret)
+		require.NoError(t, err)
+	}
+}
