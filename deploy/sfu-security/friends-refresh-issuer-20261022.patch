+func TestRelayRefreshIssuerTransportRoundTrip(t *testing.T) {
+	grants := &auth.ClaimGrants{Identity: "owned-user", Name: "Owned QA", Metadata: "owned-metadata",
+		Attributes: map[string]string{"_relay_verified_api_key": "spoofed-attribute", "owned": "kept"},
+		Video:      &auth.VideoGrant{Room: "owned-room", RoomJoin: true}}
+	init := &ParticipantInit{Identity: "owned-user", Grants: grants, VerifiedAPIKey: "verified-own-key",
+		TokenExpiresAt: time.Unix(2_000_000_000, 0), Reconnect: true}
+	logFields := zapcore.NewMapObjectEncoder()
+	require.NoError(t, init.MarshalLogObject(logFields))
+	logged, err := json.Marshal(logFields.Fields)
+	require.NoError(t, err)
+	require.NotContains(t, string(logged), init.VerifiedAPIKey)
+	for range 2 {
+		wire, err := init.ToStartSession("owned-room", "owned-connection")
+		require.NoError(t, err)
+		var raw map[string]json.RawMessage
+		require.NoError(t, json.Unmarshal([]byte(wire.GrantsJson), &raw))
+		require.JSONEq(t, `"verified-own-key"`, string(raw["_relay_verified_api_key"]))
+		require.NotEmpty(t, raw["video"], "the grants must stay flat and complete")
+		_, marshaler := any(participantClaimGrants{}).(json.Marshaler)
+		require.False(t, marshaler, "the wire alias must not inherit external MarshalJSON")
+		_, marshaler = any(&participantClaimGrants{}).(json.Marshaler)
+		require.False(t, marshaler)
+		restored, err := ParticipantInitFromStartSession(wire, "owned-region")
+		require.NoError(t, err)
+		require.Equal(t, init.VerifiedAPIKey, restored.VerifiedAPIKey)
+		require.Equal(t, grants, restored.Grants)
+		require.Equal(t, init.TokenExpiresAt, restored.TokenExpiresAt)
+		require.True(t, restored.Reconnect)
+		init = restored
+	}
+}
+
+func TestRelayRefreshIssuerLegacyWireForms(t *testing.T) {
+	grants := &auth.ClaimGrants{Identity: "owned-user", Attributes: map[string]string{"_relay_verified_api_key": "not-trusted"},
+		Video: &auth.VideoGrant{Room: "owned-room", RoomJoin: true}}
+	old, err := json.Marshal(grants)
+	require.NoError(t, err)
+	wire, err := (&ParticipantInit{Grants: grants}).ToStartSession("owned-room", "owned-connection")
+	require.NoError(t, err)
+	require.JSONEq(t, string(old), wire.GrantsJson)
+	decoded, err := ParticipantInitFromStartSession(wire, "owned-region")
+	require.NoError(t, err)
+	require.Empty(t, decoded.VerifiedAPIKey, "a similarly named user attribute is not server binding")
+	require.Equal(t, grants, decoded.Grants)
+	nilWire, err := (&ParticipantInit{VerifiedAPIKey: "no-grants-no-binding"}).ToStartSession("owned-room", "owned-connection")
+	require.NoError(t, err)
+	require.Equal(t, "null", nilWire.GrantsJson)
+	decoded, err = ParticipantInitFromStartSession(&livekit.StartSession{GrantsJson: "null"}, "owned-region")
+	require.NoError(t, err)
+	require.Equal(t, &auth.ClaimGrants{}, decoded.Grants)
+	require.Empty(t, decoded.VerifiedAPIKey)
+	for _, malformed := range []string{`{"_relay_verified_api_key":123}`, `{"_relay_verified_api_key":{}}`, ""} {
+		_, err = ParticipantInitFromStartSession(&livekit.StartSession{GrantsJson: malformed}, "owned-region")
+		require.Error(t, err)
+	}
+}
