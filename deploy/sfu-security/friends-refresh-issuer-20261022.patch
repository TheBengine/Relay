+func (r *RoomManager) participantRefreshKeyPair(participant types.LocalParticipant) (string, string, error) {
+	// This private extension avoids changing the public participant interface and
+	// cannot be overwritten by metadata/attribute or permission updates.
+	if bound, ok := participant.(interface{ TokenAPIKey() string }); ok {
+		if key := bound.TokenAPIKey(); key != "" {
+			if secret := r.config.Keys[key]; secret != "" {
+				return key, secret, nil
+			}
+			return "", "", errors.New("verified participant signing key is unavailable")
+		}
+	}
+	// Legacy routed sessions had no issuer field. There is only a safe fallback
+	// when the authoritative configuration has one unambiguous usable key.
+	if len(r.config.Keys) == 1 {
+		for key, secret := range r.config.Keys {
+			if key != "" && secret != "" {
+				return key, secret, nil
+			}
+		}
+	}
+	return "", "", errors.New("participant signing key is missing or ambiguous")
+}
