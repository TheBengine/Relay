+func TestTURNQuotaObservationTransitions(t *testing.T) {
+	q := newTURNAllocationQuota(2)
+	a, b, c := udpAddr(t, 5100), udpAddr(t, 5101), udpAddr(t, 5102)
+	require.True(t, q.Allow("qa-private-id", LivekitRealm, a))
+	require.True(t, q.Allow("qa-private-id", LivekitRealm, a)) // retry does not reserve twice
+	require.True(t, q.Allow("qa-private-id", LivekitRealm, b))
+	require.False(t, q.Allow("qa-private-id", LivekitRealm, c))
+	first := q.snapshot()
+	require.Equal(t, turnQuotaObservation{Limit: 2, Reserved: 2, Pending: 2, ReservedPeak: 2, PerIdentityPeak: 2, Denied: 1}, first)
+	q.OnCreated(a, nil, "udp", "qa-private-id", LivekitRealm, nil, 0)
+	q.OnCreated(a, nil, "udp", "qa-private-id", LivekitRealm, nil, 0)
+	q.OnCreated(c, nil, "udp", "qa-private-id", LivekitRealm, nil, 0)
+	confirmed := q.snapshot()
+	require.Equal(t, 1, confirmed.Pending)
+	require.Equal(t, 1, confirmed.Confirmed)
+	require.Equal(t, 1, confirmed.ConfirmedPeak)
+	q.OnDeleted(a, nil, "udp", "qa-private-id", LivekitRealm)
+	q.OnDeleted(a, nil, "udp", "qa-private-id", LivekitRealm)
+	q.OnDeleted(b, nil, "udp", "qa-private-id", LivekitRealm)
+	final := q.snapshot()
+	require.Zero(t, final.Reserved)
+	require.Zero(t, final.Pending)
+	require.Zero(t, final.Confirmed)
+	require.Equal(t, first.ReservedPeak, final.ReservedPeak)
+	require.Equal(t, uint64(1), final.Denied)
+}
+
+func TestTURNQuotaObservationReclaimDoesNotEvictReplacement(t *testing.T) {
+	q := newTURNAllocationQuota(1)
+	a := udpAddr(t, 5200)
+	require.True(t, q.Allow("qa", LivekitRealm, a))
+	q.mu.Lock()
+	stale := q.users["qa"][srcAddrKey(a)]
+	q.mu.Unlock()
+	q.OnDeleted(a, nil, "udp", "qa", LivekitRealm)
+	require.True(t, q.Allow("qa", LivekitRealm, a))
+	q.reclaimPending("qa", srcAddrKey(a), stale)
+	require.Equal(t, 1, q.snapshot().Pending)
+	q.mu.Lock()
+	current := q.users["qa"][srcAddrKey(a)]
+	q.mu.Unlock()
+	q.reclaimPending("qa", srcAddrKey(a), current)
+	require.Zero(t, q.snapshot().Reserved)
+	require.Zero(t, q.snapshot().Pending)
+}
+
+func TestTURNQuotaObservationConcurrentSnapshotsStayCoherent(t *testing.T) {
+	q := newTURNAllocationQuota(4)
+	var workers sync.WaitGroup
+	for worker := 0; worker < 8; worker++ {
+		workers.Add(1)
+		go func(worker int) {
+			defer workers.Done()
+			id := fmt.Sprintf("qa-%d", worker)
+			for step := 0; step < 100; step++ {
+				addr := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 5300 + worker*100 + step}
+				if q.Allow(id, LivekitRealm, addr) {
+					q.OnCreated(addr, nil, "udp", id, LivekitRealm, nil, 0)
+					q.OnDeleted(addr, nil, "udp", id, LivekitRealm)
+				}
+			}
+		}(worker)
+	}
+	done := make(chan struct{})
+	go func() { workers.Wait(); close(done) }()
+	for {
+		value := q.snapshot()
+		require.Equal(t, value.Reserved, value.Pending+value.Confirmed)
+		require.GreaterOrEqual(t, value.Pending, 0)
+		require.GreaterOrEqual(t, value.Confirmed, 0)
+		require.GreaterOrEqual(t, value.ReservedPeak, value.Reserved)
+		require.LessOrEqual(t, value.PerIdentityPeak, value.Limit)
+		select {
+		case <-done:
+			require.Zero(t, q.snapshot().Reserved)
+			return
+		default:
+		}
+	}
+}
