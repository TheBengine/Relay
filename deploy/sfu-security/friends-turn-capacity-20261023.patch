+func TestTURNQuotaObservationActual486Response(t *testing.T) {
+	before := currentRelayTURNObservation.Load()
+	t.Cleanup(func() { currentRelayTURNObservation.Store(before) })
+	serverConn := listenUDP(t)
+	serverAddr := serverConn.LocalAddr().String()
+	serverPort := serverConn.LocalAddr().(*net.UDPAddr).Port
+	require.NoError(t, serverConn.Close())
+	h := newTestTurnAuthHandler()
+	server, err := NewTurnServer(&config.Config{
+		RTC: config.RTCConfig{RTCConfig: rtcconfig.RTCConfig{NodeIP: rtcconfig.NodeIP{V4: "127.0.0.1"},
+			UDPPort: rtcconfig.PortRange{Start: 7882}}},
+		TURN: config.TURNConfig{Enabled: true, UDPPort: serverPort, BindAddresses: []string{"127.0.0.1"},
+			RelayPortRangeStart: 40000, RelayPortRangeEnd: 40100,
+			PerUserRelayAllocationLimit: 1, AllowRestrictedPeerCIDRs: []string{"127.0.0.0/8"}},
+	}, h.HandleAuth, false)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, server.Close()) })
+	username, expiry := h.CreateUsername(turnTestAPIKey, "PA_quota_observation", 300)
+	password, err := h.CreatePassword(turnTestAPIKey, "PA_quota_observation", expiry)
+	require.NoError(t, err)
+	makeClient := func() *turn.Client {
+		client, err := turn.NewClient(&turn.ClientConfig{
+			Conn: listenUDP(t), STUNServerAddr: serverAddr, TURNServerAddr: serverAddr,
+			Username: username, Password: password, Realm: LivekitRealm, RTO: 100 * time.Millisecond,
+		})
+		require.NoError(t, err)
+		t.Cleanup(client.Close)
+		require.NoError(t, client.Listen())
+		return client
+	}
+	first := makeClient()
+	relay, err := first.Allocate()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = relay.Close() })
+	second := makeClient()
+	_, err = second.Allocate()
+	require.ErrorContains(t, err, "error 486")
+	observation := currentRelayTURNObservation.Load()
+	require.NotNil(t, observation)
+	require.NotNil(t, observation.quota)
+	require.Equal(t, 101, *observation.configuredPortNumbersPerAddress())
+	value := observation.quota.snapshot()
+	require.Equal(t, 1, value.Reserved)
+	require.Equal(t, 1, value.Confirmed)
+	require.Zero(t, value.Pending)
+	require.GreaterOrEqual(t, value.Denied, uint64(1))
+}
