+func TestTURNCapacitySnapshotRedactsAndKeepsDisabledUnknown(t *testing.T) {
+	before := currentRelayTURNObservation.Load()
+	t.Cleanup(func() { currentRelayTURNObservation.Store(before) })
+	o := newRelayTURNObservation(nil, false)
+	o.relayRange = portRange{30000, 30127}
+	for _, enabled := range []bool{false, true} {
+		if enabled {
+			o.quota = newTURNAllocationQuota(12)
+			addr := udpAddr(t, 6100)
+			require.True(t, o.quota.Allow("qa-sensitive-identity", LivekitRealm, addr))
+			t.Cleanup(func() { o.quota.OnDeleted(addr, nil, "udp", "qa-sensitive-identity", LivekitRealm) })
+		}
+		currentRelayTURNObservation.Store(o)
+		r := httptest.NewRequest("GET", "/relay/turn-status", nil)
+		r.RemoteAddr = "127.0.0.1:9999"
+		w := httptest.NewRecorder()
+		relayTURNObservationHandler(w, r)
+		require.Equal(t, 200, w.Code)
+		var value map[string]any
+		require.NoError(t, json.Unmarshal(w.Body.Bytes(), &value))
+		require.Equal(t, enabled, value["quota_tracking_enabled"])
+		require.Equal(t, float64(128), value["configured_port_numbers_per_relay_address"])
+		require.NotContains(t, w.Body.String(), "qa-sensitive-identity")
+		require.NotContains(t, w.Body.String(), "127.0.0.1")
+		require.NotEmpty(t, value["observed_at"])
+		if enabled {
+			quota := value["allocation_quota"].(map[string]any)
+			require.Equal(t, float64(12), quota["limit_per_identity"])
+			require.Equal(t, float64(1), quota["pending_current"])
+			require.Equal(t, float64(0), quota["confirmed_current"])
+		} else {
+			require.Nil(t, value["allocation_quota"])
+		}
+	}
+	for _, bounds := range []portRange{{}, {30127, 30000}} {
+		o.relayRange = bounds
+		require.Nil(t, o.configuredPortNumbersPerAddress())
+	}
+}
