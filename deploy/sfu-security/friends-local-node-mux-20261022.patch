diff --git a/pkg/rtc/relay_local_node_mux.go b/pkg/rtc/relay_local_node_mux.go
new file mode 100644
--- /dev/null
+++ b/pkg/rtc/relay_local_node_mux.go
@@ -0,0 +1,67 @@
+package rtc
+
+import (
+	"net"
+
+	"github.com/pion/ice/v4"
+
+	"github.com/livekit/mediatransportutil/pkg/rtcconfig"
+)
+
+// An explicit node IP rewrites host candidates to that address. With several
+// local sockets, ICE keeps the first candidate for each rewritten address/port.
+// Prefer its actual local socket when one already exists, rather than retaining
+// a different interface's socket with the same advertised address.
+func preferExplicitLocalNodeMux(mux ice.UDPMux, conf *rtcconfig.RTCConfig) ice.UDPMux {
+	if mux == nil || conf == nil || conf.UseExternalIP || conf.NodeIPAutoGenerated {
+		return mux
+	}
+	var nodeIPs []net.IP
+	for _, value := range conf.NodeIP.ToStringSlice() {
+		if ip := net.ParseIP(value); ip != nil {
+			nodeIPs = append(nodeIPs, ip)
+		}
+	}
+	if len(nodeIPs) == 0 {
+		return mux
+	}
+	return &localNodeUDPMux{UDPMux: mux, nodeIPs: nodeIPs}
+}
+
+type localNodeUDPMux struct {
+	ice.UDPMux
+	nodeIPs []net.IP
+}
+
+var _ ice.UDPMux = (*localNodeUDPMux)(nil)
+
+func (m *localNodeUDPMux) GetListenAddresses() []net.Addr {
+	// Query once: the existing multi-port mux advances its round-robin choice on
+	// every call. Never change its backing slice, invent sockets, or alter ports.
+	addresses := m.UDPMux.GetListenAddresses()
+	ordered := make([]net.Addr, 0, len(addresses))
+	for _, address := range addresses {
+		if m.isNodeAddress(address) {
+			ordered = append(ordered, address)
+		}
+	}
+	for _, address := range addresses {
+		if !m.isNodeAddress(address) {
+			ordered = append(ordered, address)
+		}
+	}
+	return ordered
+}
+
+func (m *localNodeUDPMux) isNodeAddress(address net.Addr) bool {
+	udp, ok := address.(*net.UDPAddr)
+	if !ok || udp == nil {
+		return false
+	}
+	for _, ip := range m.nodeIPs {
+		if ip.Equal(udp.IP) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/pkg/rtc/relay_local_node_mux_test.go b/pkg/rtc/relay_local_node_mux_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/rtc/relay_local_node_mux_test.go
@@ -0,0 +1,251 @@
+package rtc
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/pion/ice/v4"
+	"github.com/stretchr/testify/require"
+
+	"github.com/livekit/mediatransportutil/pkg/rtcconfig"
+)
+
+type relayNodeMuxStub struct {
+	addresses    []net.Addr
+	listCalls    int
+	getUfrag     string
+	getAddress   net.Addr
+	getError     error
+	removedUfrag string
+	closeCalls   int
+	closeError   error
+}
+
+func (m *relayNodeMuxStub) GetListenAddresses() []net.Addr {
+	m.listCalls++
+	return m.addresses
+}
+
+func (m *relayNodeMuxStub) GetConn(ufrag string, address net.Addr) (net.PacketConn, error) {
+	m.getUfrag, m.getAddress = ufrag, address
+	return nil, m.getError
+}
+
+func (m *relayNodeMuxStub) RemoveConnByUfrag(ufrag string) { m.removedUfrag = ufrag }
+
+func (m *relayNodeMuxStub) Close() error {
+	m.closeCalls++
+	return m.closeError
+}
+
+func relayNodeUDP(ip string, port int) *net.UDPAddr {
+	return &net.UDPAddr{IP: net.ParseIP(ip), Port: port}
+}
+
+func TestRelayLocalNodeUDPMux(t *testing.T) {
+	t.Run("stable-dual-stack-copy-and-fresh-port-selection", func(t *testing.T) {
+		other := relayNodeUDP("192.0.2.20", 7882)
+		node4 := relayNodeUDP("192.0.2.10", 7882)
+		node6 := relayNodeUDP("2001:db8::10", 7882)
+		nextPort := relayNodeUDP("192.0.2.10", 7883)
+		tcp := &net.TCPAddr{IP: node4.IP, Port: 7881}
+		raw := &relayNodeMuxStub{addresses: []net.Addr{other, node6, tcp, node4, nextPort}}
+		before := append([]net.Addr(nil), raw.addresses...)
+		conf := &rtcconfig.RTCConfig{NodeIP: rtcconfig.NodeIP{V4: "192.0.2.10", V6: "2001:db8::10"}}
+		mux := preferExplicitLocalNodeMux(raw, conf)
+		addresses := mux.GetListenAddresses()
+		require.Equal(t, []net.Addr{node6, node4, nextPort, other, tcp}, addresses)
+		require.Equal(t, before, raw.addresses, "must not reorder the underlying slice")
+		require.Equal(t, 1, raw.listCalls)
+		addresses[0] = other
+		require.Equal(t, before, raw.addresses, "callers must not receive the underlying slice")
+		raw.addresses = []net.Addr{other, nextPort}
+		require.Equal(t, []net.Addr{nextPort, other}, mux.GetListenAddresses())
+		require.Equal(t, 2, raw.listCalls, "do not consume extra round-robin choices")
+	})
+	t.Run("external-generated-empty-and-nil-remain-unchanged", func(t *testing.T) {
+		for _, conf := range []*rtcconfig.RTCConfig{
+			nil,
+			{},
+			{NodeIP: rtcconfig.NodeIP{V4: "192.0.2.10"}, UseExternalIP: true},
+			{NodeIP: rtcconfig.NodeIP{V4: "192.0.2.10"}, NodeIPAutoGenerated: true},
+		} {
+			raw := &relayNodeMuxStub{addresses: []net.Addr{relayNodeUDP("192.0.2.20", 7882)}}
+			require.Same(t, raw, preferExplicitLocalNodeMux(raw, conf))
+			require.Zero(t, raw.listCalls)
+		}
+		require.Nil(t, preferExplicitLocalNodeMux(nil, &rtcconfig.RTCConfig{NodeIP: rtcconfig.NodeIP{V4: "192.0.2.10"}}))
+	})
+	t.Run("no-match-and-existing-filter-never-add-an-address", func(t *testing.T) {
+		addresses := []net.Addr{relayNodeUDP("192.0.2.20", 7882), relayNodeUDP("192.0.2.30", 7883)}
+		conf := &rtcconfig.RTCConfig{
+			NodeIP:     rtcconfig.NodeIP{V4: "192.0.2.10"},
+			IPs:        rtcconfig.IPsConfig{Excludes: []string{"192.0.2.10/32"}},
+			Interfaces: rtcconfig.InterfacesConfig{Includes: []string{"already-selected-interface"}},
+		}
+		raw := &relayNodeMuxStub{addresses: addresses}
+		require.Equal(t, addresses, preferExplicitLocalNodeMux(raw, conf).GetListenAddresses())
+		require.Equal(t, []string{"192.0.2.10/32"}, conf.IPs.Excludes)
+		require.Equal(t, []string{"already-selected-interface"}, conf.Interfaces.Includes)
+	})
+	t.Run("connection-and-lifecycle-are-delegated", func(t *testing.T) {
+		failure := errors.New("owned mux sentinel")
+		raw := &relayNodeMuxStub{getError: failure, closeError: failure}
+		mux := preferExplicitLocalNodeMux(raw, &rtcconfig.RTCConfig{NodeIP: rtcconfig.NodeIP{V4: "192.0.2.10"}})
+		address := relayNodeUDP("192.0.2.20", 7883)
+		_, err := mux.GetConn("owned-ufrag", address)
+		require.ErrorIs(t, err, failure)
+		require.Equal(t, "owned-ufrag", raw.getUfrag)
+		require.Same(t, address, raw.getAddress, "connection lookup must retain its actual bound address")
+		mux.RemoveConnByUfrag("owned-ufrag")
+		require.Equal(t, "owned-ufrag", raw.removedUfrag)
+		require.ErrorIs(t, mux.Close(), failure)
+		require.Equal(t, 1, raw.closeCalls)
+	})
+}
+
+// This fixture imposes the unfavorable order without depending on Go map order.
+// The actual sockets, per-address mux lookup and ICE packet processing stay real.
+type relayNodeOrderedMux struct {
+	ice.UDPMux
+	addresses   []net.Addr
+	connections []net.Addr
+}
+
+func (m *relayNodeOrderedMux) GetListenAddresses() []net.Addr {
+	return append([]net.Addr(nil), m.addresses...)
+}
+
+func (m *relayNodeOrderedMux) GetConn(ufrag string, address net.Addr) (net.PacketConn, error) {
+	m.connections = append(m.connections, address)
+	return m.UDPMux.GetConn(ufrag, address)
+}
+
+func TestRelayLocalNodeUDPMuxICEConnectivity(t *testing.T) {
+	for _, corrected := range []bool{false, true} {
+		name := "wrong-first-reproduces-timeout"
+		if corrected {
+			name = "preferred-local-socket-connects"
+		}
+		t.Run(name, func(t *testing.T) {
+			right, err := net.ListenUDP("udp4", relayNodeUDP("127.0.0.1", 0))
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = right.Close() })
+			wrong, err := net.ListenUDP("udp4", relayNodeUDP("127.0.0.2", right.LocalAddr().(*net.UDPAddr).Port))
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = wrong.Close() })
+			underlying := ice.NewMultiUDPMuxDefault(
+				ice.NewUDPMuxDefault(ice.UDPMuxParams{UDPConn: right}),
+				ice.NewUDPMuxDefault(ice.UDPMuxParams{UDPConn: wrong}),
+			)
+			t.Cleanup(func() { _ = underlying.Close() })
+			ordered := &relayNodeOrderedMux{UDPMux: underlying,
+				addresses: []net.Addr{wrong.LocalAddr(), right.LocalAddr()}}
+			var mux ice.UDPMux = ordered
+			if corrected {
+				mux = preferExplicitLocalNodeMux(mux, &rtcconfig.RTCConfig{NodeIP: rtcconfig.NodeIP{V4: "127.0.0.1"}})
+			}
+			server, err := ice.NewAgentWithOptions(
+				ice.WithUDPMux(mux),
+				ice.WithICELite(true),
+				ice.WithIncludeLoopback(),
+				ice.WithNetworkTypes([]ice.NetworkType{ice.NetworkTypeUDP4}),
+				ice.WithCandidateTypes([]ice.CandidateType{ice.CandidateTypeHost}),
+				ice.WithMulticastDNSMode(ice.MulticastDNSModeDisabled),
+				ice.WithAddressRewriteRules(ice.AddressRewriteRule{External: []string{"127.0.0.1"},
+					AsCandidateType: ice.CandidateTypeHost, Mode: ice.AddressRewriteReplace}),
+			)
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = server.Close() })
+			peerSocket, err := net.ListenUDP("udp4", relayNodeUDP("127.0.0.1", 0))
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = peerSocket.Close() })
+			peerMux := ice.NewUDPMuxDefault(ice.UDPMuxParams{UDPConn: peerSocket})
+			t.Cleanup(func() { _ = peerMux.Close() })
+			peer, err := ice.NewAgentWithOptions(
+				ice.WithUDPMux(peerMux),
+				ice.WithIncludeLoopback(),
+				ice.WithNetworkTypes([]ice.NetworkType{ice.NetworkTypeUDP4}),
+				ice.WithCandidateTypes([]ice.CandidateType{ice.CandidateTypeHost}),
+				ice.WithMulticastDNSMode(ice.MulticastDNSModeDisabled),
+			)
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = peer.Close() })
+			serverCandidates := relayNodeGather(t, server)
+			require.Len(t, serverCandidates, 1, "both sockets are rewritten to one advertised candidate")
+			require.Equal(t, "127.0.0.1", serverCandidates[0].Address())
+			require.Len(t, ordered.connections, 1, "duplicate elimination must retain exactly one bound socket")
+			expectedSocket := wrong.LocalAddr()
+			if corrected {
+				expectedSocket = right.LocalAddr()
+			}
+			require.Equal(t, expectedSocket, ordered.connections[0])
+			relayNodeExchange(t, peer, serverCandidates)
+			relayNodeExchange(t, server, relayNodeGather(t, peer))
+			serverUfrag, serverPassword, err := server.GetLocalUserCredentials()
+			require.NoError(t, err)
+			peerUfrag, peerPassword, err := peer.GetLocalUserCredentials()
+			require.NoError(t, err)
+			serverConn, err := server.StartAccept(peerUfrag, peerPassword)
+			require.NoError(t, err)
+			peerConn, err := peer.StartDial(serverUfrag, serverPassword)
+			require.NoError(t, err)
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			err = peer.AwaitConnect(ctx)
+			if !corrected {
+				require.ErrorIs(t, err, ice.ErrCanceledByCaller, "the advertised LAN socket must not receive another socket's ufrag")
+				require.ErrorIs(t, ctx.Err(), context.DeadlineExceeded)
+				return
+			}
+			require.NoError(t, err)
+			require.NoError(t, server.AwaitConnect(ctx))
+			relayNodeExchangePayload(t, peerConn, serverConn, "synthetic peer-to-sfu")
+			relayNodeExchangePayload(t, serverConn, peerConn, "synthetic sfu-to-peer")
+		})
+	}
+}
+
+func relayNodeGather(t *testing.T, agent *ice.Agent) []ice.Candidate {
+	t.Helper()
+	done := make(chan struct{})
+	require.NoError(t, agent.OnCandidate(func(candidate ice.Candidate) {
+		if candidate == nil {
+			close(done)
+		}
+	}))
+	require.NoError(t, agent.GatherCandidates())
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("owned ICE gathering did not finish")
+	}
+	candidates, err := agent.GetLocalCandidates()
+	require.NoError(t, err)
+	require.NotEmpty(t, candidates)
+	return candidates
+}
+
+func relayNodeExchange(t *testing.T, receiver *ice.Agent, candidates []ice.Candidate) {
+	t.Helper()
+	for _, candidate := range candidates {
+		copy, err := ice.UnmarshalCandidate(candidate.Marshal())
+		require.NoError(t, err)
+		require.NoError(t, receiver.AddRemoteCandidate(copy))
+	}
+}
+
+func relayNodeExchangePayload(t *testing.T, sender, receiver *ice.Conn, payload string) {
+	t.Helper()
+	require.NoError(t, receiver.SetReadDeadline(time.Now().Add(2*time.Second)))
+	n, err := sender.Write([]byte(payload))
+	require.NoError(t, err)
+	require.Equal(t, len(payload), n)
+	buffer := make([]byte, 64)
+	n, err = receiver.Read(buffer)
+	require.NoError(t, err)
+	require.Equal(t, payload, string(buffer[:n]))
+}
