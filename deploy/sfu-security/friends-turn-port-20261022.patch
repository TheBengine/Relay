@@ -0,0 +1,25 @@
+package config
+
+import "fmt"
+
+// ValidateExternalTLSPort rejects invalid public proxy ports before listeners
+// start. The omitted field retains the upstream advertisement on port 443.
+func (c TURNConfig) ValidateExternalTLSPort() error {
+	if c.ExternalTLSPort == 0 {
+		return nil
+	}
+	if !c.Enabled || !c.ExternalTLS || c.TLSPort < 1 || c.TLSPort > 65535 || c.ExternalTLSPort < 1 || c.ExternalTLSPort > 65535 {
+		return fmt.Errorf("turn.external_tls_port requires enabled external TLS, a valid listener and a public port from 1 to 65535")
+	}
+	return nil
+}
+
+// TLSURI is the authenticated TURN address advertised in the normal join reply.
+// It changes only the port; credentials, expiry and transport remain unchanged.
+func (c TURNConfig) TLSURI() string {
+	port := c.ExternalTLSPort
+	if port == 0 {
+		port = 443
+	}
+	return fmt.Sprintf("turns:%s:%d?transport=tcp", c.Domain, port)
+}
