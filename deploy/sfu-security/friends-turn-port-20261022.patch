@@ -0,0 +1,39 @@
+package config
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestTURNPublicTLSAddressPreservesDefaultAndUsesExplicitProxyPort(t *testing.T) {
+	for _, port := range []int{0, 10000, 65535} {
+		conf, err := NewConfig(fmt.Sprintf("turn:\n  enabled: true\n  domain: relay.example\n  tls_port: 5349\n  external_tls: true\n  external_tls_port: %d\n", port), true, nil, nil)
+		if err != nil {
+			t.Fatalf("valid public proxy port %d: %v", port, err)
+		}
+		expected := port
+		if expected == 0 {
+			expected = 443
+		}
+		if got := conf.TURN.TLSURI(); got != fmt.Sprintf("turns:relay.example:%d?transport=tcp", expected) {
+			t.Fatalf("public URI for %d: %q", port, got)
+		}
+		if conf.TURN.TLSPort != 5349 {
+			t.Fatal("public advertisement changed the listener")
+		}
+	}
+}
+
+func TestTURNPublicTLSPortRejectsInvalidOrUnconfiguredProxy(t *testing.T) {
+	for _, input := range []string{
+		"enabled: true\n  external_tls: true\n  tls_port: 5349\n  external_tls_port: -1",
+		"enabled: true\n  external_tls: true\n  tls_port: 5349\n  external_tls_port: 65536",
+		"enabled: true\n  external_tls: false\n  tls_port: 5349\n  external_tls_port: 10000",
+		"enabled: true\n  external_tls: true\n  tls_port: 0\n  external_tls_port: 10000",
+		"enabled: false\n  external_tls: true\n  tls_port: 5349\n  external_tls_port: 10000",
+	} {
+		if _, err := NewConfig("turn:\n  "+input+"\n", true, nil, nil); err == nil {
+			t.Fatal("invalid public TURN proxy configuration was accepted")
+		}
+	}
+}
