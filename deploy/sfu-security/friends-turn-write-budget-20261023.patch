new file mode 100644
--- /dev/null
+++ b/pkg/service/relay_turn_write_budget.go
@@ -0,0 +1,232 @@
+// Copyright 2026 LiveKit, Inc.
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+
+package service
+
+import (
+	"errors"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"time"
+)
+
+const (
+	relayTURNWriteStall = 2 * time.Second
+	relayTURNWriteCalls = 16
+	relayTURNWriteBytes = 256 * 1024
+)
+
+var errRelayTURNWriteAdmission = errors.New("TURN TCP write admission budget exceeded")
+
+// No copied queue or worker: each admitted caller owns its synchronous write.
+// This sits below crypto/tls and PROXY, and bounds only this layer's pending
+// buffers and socket-write/gate age. TLS's upstream mutex, kernel, proxy and
+// network buffering are outside this contract; this is not a latency bound.
+type relayTURNWriteListener struct{ net.Listener }
+
+func (l *relayTURNWriteListener) Accept() (net.Conn, error) {
+	conn, err := l.Listener.Accept()
+	if err != nil {
+		return nil, err
+	}
+	return newRelayTURNWriteConn(conn), nil
+}
+
+type relayTURNWriteConn struct {
+	net.Conn
+	mu                 sync.Mutex
+	closed             bool
+	done               chan struct{}
+	changed            chan struct{}
+	gate               chan struct{}
+	callerDeadline     time.Time
+	activeCap          time.Time
+	calls, bytes       int
+	stall              time.Duration
+	maxCalls, maxBytes int
+}
+
+func newRelayTURNWriteConn(conn net.Conn) *relayTURNWriteConn {
+	c := &relayTURNWriteConn{Conn: conn, done: make(chan struct{}), changed: make(chan struct{}),
+		gate: make(chan struct{}, 1), stall: relayTURNWriteStall, maxCalls: relayTURNWriteCalls, maxBytes: relayTURNWriteBytes}
+	c.gate <- struct{}{}
+	return c
+}
+
+func earlierTURNDeadline(a, b time.Time) time.Time {
+	if a.IsZero() || !b.IsZero() && b.Before(a) {
+		return b
+	}
+	return a
+}
+
+// Mark terminal while holding the same lock as admission and deadline state.
+// Closing the underlying socket happens outside this lock and never waits to
+// acquire the write gate.
+func (c *relayTURNWriteConn) markClosedLocked() bool {
+	if c.closed {
+		return false
+	}
+	c.closed = true
+	close(c.done)
+	return true
+}
+
+func (c *relayTURNWriteConn) Close() error {
+	c.mu.Lock()
+	closeRaw := c.markClosedLocked()
+	c.mu.Unlock()
+	if !closeRaw {
+		return net.ErrClosed
+	}
+	// There is no worker to join, and Close never waits for the write gate.
+	return c.Conn.Close()
+}
+
+func (c *relayTURNWriteConn) SetWriteDeadline(t time.Time) error {
+	return c.setCallerDeadline(t, false)
+}
+
+func (c *relayTURNWriteConn) SetDeadline(t time.Time) error {
+	return c.setCallerDeadline(t, true)
+}
+
+func (c *relayTURNWriteConn) setCallerDeadline(t time.Time, includeRead bool) error {
+	c.mu.Lock()
+	if c.closed {
+		c.mu.Unlock()
+		return net.ErrClosed
+	}
+	c.callerDeadline = t
+	close(c.changed)
+	c.changed = make(chan struct{})
+	var err error
+	if includeRead {
+		err = c.Conn.SetReadDeadline(t)
+	}
+	if err == nil {
+		err = c.Conn.SetWriteDeadline(earlierTURNDeadline(t, c.activeCap))
+	}
+	closeRaw := err != nil && c.markClosedLocked()
+	c.mu.Unlock()
+	if closeRaw {
+		_ = c.Conn.Close()
+	}
+	return err
+}
+
+func (c *relayTURNWriteConn) acquire(cap time.Time) error {
+	for {
+		c.mu.Lock()
+		if c.closed {
+			c.mu.Unlock()
+			return net.ErrClosed
+		}
+		deadline := earlierTURNDeadline(cap, c.callerDeadline)
+		changed := c.changed
+		c.mu.Unlock()
+		remaining := time.Until(deadline)
+		if remaining <= 0 {
+			return os.ErrDeadlineExceeded
+		}
+		timer := time.NewTimer(remaining)
+		var err error
+		acquired := false
+		select {
+		case <-c.done:
+			err = net.ErrClosed
+		case <-timer.C:
+			err = os.ErrDeadlineExceeded
+		case <-changed:
+		case <-c.gate:
+			acquired = true
+		}
+		if !timer.Stop() {
+			select {
+			case <-timer.C:
+			default:
+			}
+		}
+		if err != nil || acquired {
+			return err
+		}
+	}
+}
+
+func (c *relayTURNWriteConn) Write(p []byte) (n int, err error) {
+	cap := time.Now().Add(c.stall)
+	c.mu.Lock()
+	if c.closed {
+		c.mu.Unlock()
+		return 0, net.ErrClosed
+	}
+	if len(p) == 0 {
+		c.mu.Unlock()
+		return 0, nil
+	}
+	if c.calls >= c.maxCalls || len(p) > c.maxBytes || c.bytes > c.maxBytes-len(p) {
+		closeRaw := c.markClosedLocked()
+		c.mu.Unlock()
+		if closeRaw {
+			_ = c.Conn.Close()
+		}
+		return 0, errRelayTURNWriteAdmission
+	}
+	c.calls++
+	c.bytes += len(p)
+	c.mu.Unlock()
+	defer func() {
+		c.mu.Lock()
+		c.calls--
+		c.bytes -= len(p)
+		c.mu.Unlock()
+	}()
+	if err = c.acquire(cap); err != nil {
+		_ = c.Close()
+		return 0, err
+	}
+	defer func() {
+		c.mu.Lock()
+		c.activeCap = time.Time{}
+		if err == nil && !c.closed {
+			err = c.Conn.SetWriteDeadline(c.callerDeadline)
+		}
+		closeRaw := err != nil && c.markClosedLocked()
+		c.mu.Unlock()
+		if closeRaw {
+			_ = c.Conn.Close()
+		}
+		c.gate <- struct{}{}
+	}()
+	c.mu.Lock()
+	if c.closed {
+		err = net.ErrClosed
+	} else {
+		c.activeCap = cap
+		err = c.Conn.SetWriteDeadline(earlierTURNDeadline(cap, c.callerDeadline))
+	}
+	c.mu.Unlock()
+	if err != nil {
+		return 0, err
+	}
+	// Preserve exact bytes, including TURN padding and unknown control traffic.
+	// Serialize partial writes; after any error no subsequent frame is allowed.
+	for n < len(p) {
+		written, writeErr := c.Conn.Write(p[n:])
+		if written < 0 || written > len(p)-n {
+			return n, io.ErrShortWrite
+		}
+		n += written
+		if writeErr != nil {
+			return n, writeErr
+		}
+		if written == 0 {
+			return n, io.ErrShortWrite
+		}
+	}
+	return n, nil
+}
diff --git a/pkg/service/relay_turn_write_budget_test.go b/pkg/service/relay_turn_write_budget_test.go
