+func TestRelayTURNWriteBudgetInternalTLSRemainsOuterAndProxyAddressesSurvive(t *testing.T) {
+	public, private, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "owned.invalid"},
+		DNSNames: []string{"owned.invalid"}, NotBefore: time.Now().Add(-time.Minute), NotAfter: time.Now().Add(time.Hour),
+		KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, public, private)
+	require.NoError(t, err)
+	key, err := x509.MarshalPKCS8PrivateKey(private)
+	require.NoError(t, err)
+	folder := t.TempDir()
+	certPath, keyPath := filepath.Join(folder, "owned-cert.pem"), filepath.Join(folder, "owned-key.pem")
+	require.NoError(t, os.WriteFile(certPath, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), 0o600))
+	require.NoError(t, os.WriteFile(keyPath, pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: key}), 0o600))
+	listener, err := newTURNTCPListener(config.TURNConfig{CertFile: certPath, KeyFile: keyPath, ProxyProtocol: true,
+		ProxyProtocolTrustedCIDRs: []string{"127.0.0.0/8"}}, "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+	complete := make(chan error, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			complete <- err
+			return
+		}
+		defer conn.Close()
+		tlsConn, ok := conn.(*tls.Conn)
+		if !ok {
+			complete <- errors.New("Pion TLS type no longer visible")
+			return
+		}
+		if err = conn.SetDeadline(time.Now().Add(3 * time.Second)); err == nil {
+			err = tlsConn.Handshake()
+		}
+		if err == nil && conn.RemoteAddr().String() != "203.0.113.9:40123" {
+			err = errors.New("PROXY remote address changed")
+		}
+		if err == nil && conn.LocalAddr().String() != "127.0.0.1:443" {
+			err = errors.New("PROXY local address changed")
+		}
+		payload := make([]byte, 4)
+		if err == nil {
+			_, err = io.ReadFull(conn, payload)
+		}
+		if err == nil && !bytes.Equal(payload, []byte("ping")) {
+			err = errors.New("control bytes changed")
+		}
+		if err == nil {
+			_, err = conn.Write([]byte("pong"))
+		}
+		complete <- err
+	}()
+	raw, err := net.DialTimeout("tcp", listener.Addr().String(), time.Second)
+	require.NoError(t, err)
+	defer raw.Close()
+	require.NoError(t, raw.SetDeadline(time.Now().Add(3*time.Second)))
+	_, err = raw.Write([]byte("PROXY TCP4 203.0.113.9 127.0.0.1 40123 443\r\n"))
+	require.NoError(t, err)
+	cert, err := x509.ParseCertificate(der)
+	require.NoError(t, err)
+	roots := x509.NewCertPool()
+	roots.AddCert(cert)
+	client := tls.Client(raw, &tls.Config{MinVersion: tls.VersionTLS12, RootCAs: roots, ServerName: "owned.invalid"})
+	defer client.Close()
+	require.NoError(t, client.Handshake())
+	_, err = client.Write([]byte("ping"))
+	require.NoError(t, err)
+	reply := make([]byte, 4)
+	_, err = io.ReadFull(client, reply)
+	require.NoError(t, err)
+	require.Equal(t, []byte("pong"), reply)
+	select {
+	case err := <-complete:
+		require.NoError(t, err)
+	case <-time.After(3 * time.Second):
+		t.Fatal("owned TLS/PROXY handler did not finish")
+	}
+}
