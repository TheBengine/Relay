+++ b/pkg/service/relay_turn_write_budget_test.go
@@ -0,0 +1,504 @@
+// Copyright 2026 LiveKit, Inc.
+// Licensed under the Apache License, Version 2.0.
+
+package service
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"errors"
+	"io"
+	"math/big"
+	"net"
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/livekit/livekit-server/pkg/config"
+	"github.com/pion/stun/v3"
+	"github.com/stretchr/testify/require"
+)
+
+type relayTURNBudgetTestConn struct {
+	mu                          sync.Mutex
+	data                        []byte
+	step                        int
+	writeErr                    error
+	zero                        bool
+	failDeadline                bool
+	readDeadline, writeDeadline time.Time
+	changed                     chan struct{}
+	release                     <-chan struct{}
+	entered                     chan struct{}
+	closed                      chan struct{}
+	beforeClose                 func()
+	closeOnce                   sync.Once
+	closeCalls                  atomic.Int32
+}
+
+func newRelayTURNBudgetTestConn() *relayTURNBudgetTestConn {
+	return &relayTURNBudgetTestConn{changed: make(chan struct{}), entered: make(chan struct{}, 32), closed: make(chan struct{})}
+}
+func (c *relayTURNBudgetTestConn) Write(p []byte) (int, error) {
+	select {
+	case c.entered <- struct{}{}:
+	default:
+	}
+	if c.release != nil {
+		waiting := true
+		for waiting {
+			c.mu.Lock()
+			deadline, changed := c.writeDeadline, c.changed
+			c.mu.Unlock()
+			var timer *time.Timer
+			var timeout <-chan time.Time
+			if !deadline.IsZero() {
+				timer = time.NewTimer(time.Until(deadline))
+				timeout = timer.C
+			}
+			var err error
+			select {
+			case <-c.closed:
+				err = net.ErrClosed
+			case <-timeout:
+				err = os.ErrDeadlineExceeded
+			case <-changed:
+			case <-c.release:
+				waiting = false
+			}
+			if timer != nil && !timer.Stop() {
+				select {
+				case <-timer.C:
+				default:
+				}
+			}
+			if err != nil {
+				return 0, err
+			}
+		}
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	select {
+	case <-c.closed:
+		return 0, net.ErrClosed
+	default:
+	}
+	if c.zero {
+		return 0, nil
+	}
+	n := len(p)
+	if c.step > 0 && n > c.step {
+		n = c.step
+	}
+	c.data = append(c.data, p[:n]...)
+	return n, c.writeErr
+}
+func (c *relayTURNBudgetTestConn) Read(p []byte) (int, error) { return 0, io.EOF }
+func (c *relayTURNBudgetTestConn) Close() error {
+	c.closeOnce.Do(func() {
+		c.closeCalls.Add(1)
+		if c.beforeClose != nil {
+			c.beforeClose()
+		}
+		close(c.closed)
+	})
+	return nil
+}
+func (c *relayTURNBudgetTestConn) LocalAddr() net.Addr {
+	return &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 10000}
+}
+func (c *relayTURNBudgetTestConn) RemoteAddr() net.Addr {
+	return &net.TCPAddr{IP: net.IPv4(192, 0, 2, 9), Port: 40000}
+}
+func (c *relayTURNBudgetTestConn) SetReadDeadline(t time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.readDeadline = t
+	return nil
+}
+func (c *relayTURNBudgetTestConn) SetWriteDeadline(t time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.failDeadline {
+		return io.ErrClosedPipe
+	}
+	c.writeDeadline = t
+	close(c.changed)
+	c.changed = make(chan struct{})
+	return nil
+}
+func (c *relayTURNBudgetTestConn) SetDeadline(t time.Time) error {
+	if err := c.SetReadDeadline(t); err != nil {
+		return err
+	}
+	return c.SetWriteDeadline(t)
+}
+
+type relayTURNWriteResult struct {
+	n   int
+	err error
+}
+
+func startRelayTURNWrite(c net.Conn, p []byte) <-chan relayTURNWriteResult {
+	out := make(chan relayTURNWriteResult, 1)
+	go func() { n, err := c.Write(p); out <- relayTURNWriteResult{n, err} }()
+	return out
+}
+func awaitRelayTURNWrite(t *testing.T, out <-chan relayTURNWriteResult) relayTURNWriteResult {
+	t.Helper()
+	select {
+	case result := <-out:
+		return result
+	case <-time.After(3 * time.Second):
+		t.Fatal("owned TURN write did not terminate")
+		return relayTURNWriteResult{}
+	}
+}
+func awaitRelayTURNCalls(t *testing.T, c *relayTURNWriteConn, count int) {
+	t.Helper()
+	require.Eventually(t, func() bool { c.mu.Lock(); defer c.mu.Unlock(); return c.calls == count && !c.activeCap.IsZero() }, time.Second, time.Millisecond)
+}
+func requireRelayTURNReleased(t *testing.T, c *relayTURNWriteConn) {
+	t.Helper()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	require.Zero(t, c.calls)
+	require.Zero(t, c.bytes)
+}
+
+func TestRelayTURNWriteBudgetPartialWritesPreserveBytesAndSerialization(t *testing.T) {
+	release := make(chan struct{})
+	raw := newRelayTURNBudgetTestConn()
+	raw.step = 3
+	raw.release = release
+	c := newRelayTURNWriteConn(raw)
+	defer c.Close()
+	// Valid STUN plus ChannelData carrying DTLS-like bytes, including padding.
+	control := stun.MustBuild(stun.TransactionID, stun.BindingRequest).Raw
+	channel := append([]byte{0x40, 0x01, 0, 15}, append([]byte{22, 0xfe, 0xfd}, make([]byte, 12)...)...)
+	channel = append(channel, 0) // 4-byte stream padding, preserved verbatim
+	first := append(append([]byte{}, control...), channel...)
+	a := startRelayTURNWrite(c, first)
+	select {
+	case <-raw.entered:
+	case <-time.After(time.Second):
+		t.Fatal("first owned write not entered")
+	}
+	b := startRelayTURNWrite(c, control)
+	awaitRelayTURNCalls(t, c, 2)
+	close(release)
+	for _, result := range []relayTURNWriteResult{awaitRelayTURNWrite(t, a), awaitRelayTURNWrite(t, b)} {
+		require.NoError(t, result.err)
+	}
+	raw.mu.Lock()
+	observed := append([]byte{}, raw.data...)
+	raw.mu.Unlock()
+	require.Equal(t, append(first, control...), observed)
+	requireRelayTURNReleased(t, c)
+}
+
+func TestRelayTURNWriteBudgetSlowReaderClosesStream(t *testing.T) {
+	server, peer := net.Pipe()
+	defer peer.Close()
+	// Install the fixture read deadline while both ends are open. Go rejects
+	// deadline changes after the peer has already closed this pipe.
+	require.NoError(t, peer.SetReadDeadline(time.Now().Add(time.Second)))
+	c := newRelayTURNWriteConn(server)
+	c.stall = 40 * time.Millisecond
+	defer c.Close()
+	result := awaitRelayTURNWrite(t, startRelayTURNWrite(c, []byte("owned complete control frame")))
+	require.ErrorIs(t, result.err, os.ErrDeadlineExceeded)
+	require.Zero(t, result.n)
+	_, err := c.Write([]byte("later frame"))
+	require.ErrorIs(t, err, net.ErrClosed)
+	_, err = peer.Read(make([]byte, 1))
+	require.ErrorIs(t, err, io.EOF)
+	requireRelayTURNReleased(t, c)
+}
+
+func TestRelayTURNWriteBudgetCloseUnblocksActiveAndGateWaiters(t *testing.T) {
+	server, peer := net.Pipe()
+	defer peer.Close()
+	c := newRelayTURNWriteConn(server)
+	defer c.Close()
+	a := startRelayTURNWrite(c, []byte("first"))
+	awaitRelayTURNCalls(t, c, 1)
+	b := startRelayTURNWrite(c, []byte("second"))
+	awaitRelayTURNCalls(t, c, 2)
+	require.NoError(t, c.Close())
+	for _, result := range []relayTURNWriteResult{awaitRelayTURNWrite(t, a), awaitRelayTURNWrite(t, b)} {
+		require.Error(t, result.err)
+	}
+	requireRelayTURNReleased(t, c)
+}
+
+func TestRelayTURNWriteBudgetCallerDeadlinesDoNotResetActiveCap(t *testing.T) {
+	release := make(chan struct{})
+	raw := newRelayTURNBudgetTestConn()
+	raw.release = release
+	c := newRelayTURNWriteConn(raw)
+	defer c.Close()
+	future := time.Now().Add(time.Hour)
+	require.NoError(t, c.SetWriteDeadline(future))
+	out := startRelayTURNWrite(c, []byte("owned data"))
+	select {
+	case <-raw.entered:
+	case <-time.After(time.Second):
+		t.Fatal("owned write not entered")
+	}
+	c.mu.Lock()
+	cap := c.activeCap
+	c.mu.Unlock()
+	require.False(t, cap.IsZero())
+	for _, deadline := range []time.Time{time.Time{}, future} {
+		require.NoError(t, c.SetWriteDeadline(deadline))
+		raw.mu.Lock()
+		actual := raw.writeDeadline
+		raw.mu.Unlock()
+		require.Equal(t, cap, actual)
+	}
+	earlier := time.Now().Add(time.Second)
+	require.NoError(t, c.SetDeadline(earlier))
+	raw.mu.Lock()
+	read, write := raw.readDeadline, raw.writeDeadline
+	raw.mu.Unlock()
+	require.Equal(t, earlier, read)
+	require.Equal(t, earlier, write)
+	require.NoError(t, c.SetWriteDeadline(future))
+	close(release)
+	require.NoError(t, awaitRelayTURNWrite(t, out).err)
+	raw.mu.Lock()
+	restored := raw.writeDeadline
+	raw.mu.Unlock()
+	require.Equal(t, future, restored)
+	require.Equal(t, raw.LocalAddr(), c.LocalAddr())
+	require.Equal(t, raw.RemoteAddr(), c.RemoteAddr())
+	requireRelayTURNReleased(t, c)
+}
+
+func TestRelayTURNWriteBudgetQueuedCallerDeadlineWakesAllWriters(t *testing.T) {
+	raw := newRelayTURNBudgetTestConn()
+	raw.release = make(chan struct{})
+	c := newRelayTURNWriteConn(raw)
+	defer c.Close()
+	a := startRelayTURNWrite(c, []byte("first"))
+	select {
+	case <-raw.entered:
+	case <-time.After(time.Second):
+		t.Fatal("owned write not entered")
+	}
+	b := startRelayTURNWrite(c, []byte("second"))
+	awaitRelayTURNCalls(t, c, 2)
+	require.NoError(t, c.SetWriteDeadline(time.Now().Add(-time.Second)))
+	timeoutObserved := false
+	for _, result := range []relayTURNWriteResult{awaitRelayTURNWrite(t, a), awaitRelayTURNWrite(t, b)} {
+		require.Error(t, result.err)
+		timeoutObserved = timeoutObserved || errors.Is(result.err, os.ErrDeadlineExceeded)
+	}
+	require.True(t, timeoutObserved, "an expired caller deadline terminates an owned write, not just the later Close")
+	require.EqualValues(t, 1, raw.closeCalls.Load())
+	requireRelayTURNReleased(t, c)
+}
+
+func TestRelayTURNWriteBudgetAdmissionAndOversizeAreTerminalAndReleaseReservations(t *testing.T) {
+	for _, kind := range []string{"oversize", "calls", "bytes"} {
+		t.Run(kind, func(t *testing.T) {
+			raw := newRelayTURNBudgetTestConn()
+			raw.release = make(chan struct{})
+			c := newRelayTURNWriteConn(raw)
+			defer c.Close()
+			if kind == "oversize" {
+				n, err := c.Write(make([]byte, c.maxBytes+1))
+				require.Zero(t, n)
+				require.ErrorIs(t, err, errRelayTURNWriteAdmission)
+			} else {
+				if kind == "calls" {
+					c.maxCalls = 1
+				} else {
+					c.maxBytes = 3
+				}
+				first := startRelayTURNWrite(c, []byte("AA"))
+				select {
+				case <-raw.entered:
+				case <-time.After(time.Second):
+					t.Fatal("owned write not entered")
+				}
+				n, err := c.Write([]byte("BB"))
+				require.Zero(t, n)
+				require.ErrorIs(t, err, errRelayTURNWriteAdmission)
+				require.Error(t, awaitRelayTURNWrite(t, first).err)
+			}
+			require.EqualValues(t, 1, raw.closeCalls.Load())
+			requireRelayTURNReleased(t, c)
+			raw.mu.Lock()
+			require.Empty(t, raw.data)
+			raw.mu.Unlock()
+		})
+	}
+}
+
+func TestRelayTURNWriteBudgetPartialFailureZeroProgressAndDeadlineErrorsClose(t *testing.T) {
+	for _, kind := range []string{"partial", "zero", "deadline"} {
+		t.Run(kind, func(t *testing.T) {
+			raw := newRelayTURNBudgetTestConn()
+			if kind == "partial" {
+				raw.step = 2
+				raw.writeErr = io.ErrUnexpectedEOF
+			}
+			if kind == "zero" {
+				raw.zero = true
+			}
+			if kind == "deadline" {
+				raw.failDeadline = true
+			}
+			c := newRelayTURNWriteConn(raw)
+			defer c.Close()
+			n, err := c.Write([]byte("AAAA"))
+			require.Error(t, err)
+			if kind == "partial" {
+				require.Equal(t, 2, n)
+			} else {
+				require.Zero(t, n)
+			}
+			_, err = c.Write([]byte("BBBB"))
+			require.ErrorIs(t, err, net.ErrClosed)
+			require.EqualValues(t, 1, raw.closeCalls.Load())
+			requireRelayTURNReleased(t, c)
+			raw.mu.Lock()
+			require.False(t, bytes.Contains(raw.data, []byte("B")))
+			raw.mu.Unlock()
+		})
+	}
+}
+
+func TestRelayTURNWriteBudgetTerminalStatePrecedesUnderlyingClose(t *testing.T) {
+	raw := newRelayTURNBudgetTestConn()
+	c := newRelayTURNWriteConn(raw)
+	defer c.Close()
+	c.maxBytes = 1
+	type closeObservation struct {
+		closed, done          bool
+		writeErr, deadlineErr error
+		calls, bytes          int
+	}
+	observed := make(chan closeObservation, 1)
+	// The underlying Close can inspect wrapper state without waiting for its
+	// state mutex or the gate. New writes/deadlines must already be refused.
+	raw.beforeClose = func() {
+		var snapshot closeObservation
+		c.mu.Lock()
+		snapshot.closed, snapshot.calls, snapshot.bytes = c.closed, c.calls, c.bytes
+		c.mu.Unlock()
+		select {
+		case <-c.done:
+			snapshot.done = true
+		default:
+		}
+		_, snapshot.writeErr = c.Write([]byte("B"))
+		snapshot.deadlineErr = c.SetWriteDeadline(time.Now().Add(time.Hour))
+		observed <- snapshot
+	}
+	result := awaitRelayTURNWrite(t, startRelayTURNWrite(c, []byte("AA")))
+	require.ErrorIs(t, result.err, errRelayTURNWriteAdmission)
+	select {
+	case snapshot := <-observed:
+		require.True(t, snapshot.closed)
+		require.True(t, snapshot.done)
+		require.ErrorIs(t, snapshot.writeErr, net.ErrClosed)
+		require.ErrorIs(t, snapshot.deadlineErr, net.ErrClosed)
+		require.Zero(t, snapshot.calls)
+		require.Zero(t, snapshot.bytes)
+	case <-time.After(time.Second):
+		t.Fatal("underlying Close did not observe terminal wrapper state")
+	}
+	require.EqualValues(t, 1, raw.closeCalls.Load())
+	requireRelayTURNReleased(t, c)
+}
