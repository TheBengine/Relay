+
+func (o *relayTURNObservation) observeSTUN(read bool, payload []byte) {
+	if len(payload) < 20 || binary.BigEndian.Uint32(payload[4:8]) != 0x2112A442 {
+		return
+	}
+	size := int(binary.BigEndian.Uint16(payload[2:4]))
+	if size%4 != 0 || size+20 != len(payload) {
+		return
+	}
+	kind := binary.BigEndian.Uint16(payload[:2])
+	if read {
+		switch kind {
+		case 0x0001:
+			o.readBindingRequest.Add(1)
+		case 0x0101:
+			o.readBindingSuccess.Add(1)
+		case 0x0111:
+			o.readBindingError.Add(1)
+		}
+	} else {
+		switch kind {
+		case 0x0001:
+			o.writeBindingRequest.Add(1)
+		case 0x0101:
+			o.writeBindingSuccess.Add(1)
+		case 0x0111:
+			o.writeBindingError.Add(1)
+		}
+	}
+}
+
+func (o *relayTURNObservation) observeReadSource(addr net.Addr) {
+	peer, ok := addr.(*net.UDPAddr)
+	if !ok {
+		o.readOtherIP.Add(1)
+		return
+	}
+	if peer.IP.IsLoopback() {
+		o.readLoopback.Add(1)
+	}
+	for _, expected := range o.nodeIPs {
+		if expected != nil && expected.Equal(peer.IP) {
+			o.readNodeIP.Add(1)
+			return
+		}
+	}
+	o.readOtherIP.Add(1)
 }
 
