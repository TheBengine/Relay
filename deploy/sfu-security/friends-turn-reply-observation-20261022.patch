 func TestRelayTURNObservation(t *testing.T) {
+	t.Run("bounded-stun-type-and-source-classes", func(t *testing.T) {
+		observation := newRelayTURNObservation(nil, false)
+		observation.nodeIPs = []net.IP{net.ParseIP("192.0.2.10")}
+		for _, kind := range []uint16{0x0001, 0x0101, 0x0111} {
+			payload := make([]byte, 20)
+			binary.BigEndian.PutUint16(payload[:2], kind)
+			binary.BigEndian.PutUint32(payload[4:8], 0x2112A442)
+			observation.observeSTUN(true, payload)
+			observation.observeSTUN(false, payload)
+			observation.observeSTUN(true, payload[:19])
+			observation.observeSTUN(true, append(payload, 0))
+		}
+		require.Equal(t, uint64(1), observation.readBindingRequest.Load())
+		require.Equal(t, uint64(1), observation.readBindingSuccess.Load())
+		require.Equal(t, uint64(1), observation.readBindingError.Load())
+		require.Equal(t, uint64(1), observation.writeBindingRequest.Load())
+		require.Equal(t, uint64(1), observation.writeBindingSuccess.Load())
+		require.Equal(t, uint64(1), observation.writeBindingError.Load())
+		for _, ip := range []string{"127.0.0.1", "192.0.2.10", "192.0.2.11"} {
+			observation.observeReadSource(&net.UDPAddr{IP: net.ParseIP(ip), Port: 7882})
+		}
+		require.Equal(t, uint64(1), observation.readLoopback.Load())
+		require.Equal(t, uint64(1), observation.readNodeIP.Load())
+		require.Equal(t, uint64(2), observation.readOtherIP.Load())
+	})
 	t.Run("loopback-only-redacted-snapshot", func(t *testing.T) {
 		before := currentRelayTURNObservation.Load()
 		t.Cleanup(func() { currentRelayTURNObservation.Store(before) })
