@@ -136,9 +138,30 @@
 
 func (c *turnRelayPacketConn) WriteTo(p []byte, addr net.Addr) (int, error) {
 	if !c.policy.allows(addr) {
+		if observation := c.policy.observation; observation != nil {
+			observation.portDenied.Add(1)
+		}
 		return len(p), nil
 	}
-	return c.PacketConn.WriteTo(p, addr)
+	n, err := c.PacketConn.WriteTo(p, addr)
+	if observation := c.policy.observation; observation != nil {
+		if err != nil {
+			observation.udpWriteErrors.Add(1)
+		} else {
+			observation.udpWrites.Add(1)
+			observation.udpWriteBytes.Add(uint64(n))
+		}
+	}
+	return n, err
+}
+
+func (c *turnRelayPacketConn) ReadFrom(p []byte) (int, net.Addr, error) {
+	n, addr, err := c.PacketConn.ReadFrom(p)
+	if observation := c.policy.observation; observation != nil && err == nil {
+		observation.udpReads.Add(1)
+		observation.udpReadBytes.Add(uint64(n))
+	}
+	return n, addr, err
 }
 
